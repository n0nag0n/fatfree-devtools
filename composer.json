{
	"name": "n0nag0n/fatfree-devtools",
	"description": "A set of tools for help in creating models, controllers, routes, etc.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "n0nag0n",
			"email": "n0nag0n@sky-9.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"bcosca/fatfree-core": "^3.7",
		"ikkez/f3-flash": "^1.0",
		"n0nag0n/fatfree-environment-check": "^0.1.0",
		"net-tools/composer-interface": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"classmap" : [ "utils", "controllers", "models" ]
	},
	"autoload-dev": {
		"classmap": [ "tests" ]
	},
	"bin": "bin/fatfree"
}
